<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fmorrisey.hdmi-audio-stereo</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/hdmi-audio-stereo</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/hdmi-audio-stereo.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/hdmi-audio-stereo.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Target channel count for display-audio endpoints: 2 for TV speakers, 6 for a 5.1 soundbar/AVR over eARC. -->
        <key>HDMI_AUDIO_STEREO_CHANNELS</key>
        <string>6</string>
        <!-- Speaker assignment per device channel (CoreAudio labels 1=L 2=R 3=C 4=LFE 5=Ls 6=Rs), applied whenever the
             endpoint has that many channels. 1,2,4,3,5,6 is the HDMI wire order most TVs expect (LFE on 3, Center on 4);
             it is what Audio MIDI Setup's "Configure Speakers" writes, but that only sticks per device identity. -->
        <key>HDMI_AUDIO_STEREO_LAYOUT</key>
        <string>1,2,4,3,5,6</string>
        <!-- Uncomment to manage only specific device names instead of every HDMI / DisplayPort output:
        <key>HDMI_AUDIO_STEREO_DEVICES</key>
        <string>SAMSUNG</string>
        -->
        <!-- stable output: wrap the TV endpoint in an aggregate device named "TV" and keep that the default output,
             so a TV blink never changes the default and Wine games keep their stream (0 to disable; --aggregate on|off at runtime) -->
        <key>HDMI_AUDIO_STEREO_AGGREGATE</key><string>1</string>
        <key>HDMI_AUDIO_STEREO_AGGREGATE_NAME</key><string>TV</string>
        <!-- manage only these output devices by name (the TV); without it every HDMI/DisplayPort audio output is managed -->
        <key>HDMI_AUDIO_STEREO_DEVICES</key><string>SAMSUNG</string>
        <!-- keep a silent stream running on the TV endpoint so the HDMI audio link never stops (0 to disable; --keepalive on|off at runtime) -->
        <!-- bounce the channel count 6->2->6 ~25 s after every link-up so the TV hands the soundbar 5.1 (0 to disable; --bounce on|off at runtime) -->
        <key>HDMI_AUDIO_STEREO_BOUNCE</key><string>1</string>
        <key>HDMI_AUDIO_STEREO_BOUNCE_DELAY</key><string>25</string>
        <key>HDMI_AUDIO_STEREO_KEEPALIVE</key><string>1</string>
        <key>HDMI_AUDIO_STEREO_NOTIFY</key>
        <string>1</string>
        <!-- Hand the default output back to a display endpoint that vanished and returned (1), or leave macOS's fallback alone (0). -->
        <key>HDMI_AUDIO_STEREO_RESTORE_DEFAULT</key>
        <string>1</string>
    </dict>
</dict>
</plist>
